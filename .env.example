# Пример конфигурации без секретов. Скопируйте в .env и заполните при необходимости.
# Без LLM_API_KEY AI-buddy работает в офлайн-режиме (детерминированный агент).

# OpenAI-совместимый API: OpenAI, OpenRouter, vLLM, Ollama, шлюзы к YandexGPT/GigaChat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Пример для OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# Пример для локальной Ollama (из Docker):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b-instruct

# Общий секрет подписи токенов mock-SSO
IDENTITY_SECRET=change-me-in-prod
DEMO_PASSWORD=buddy2026
CORP_ADMIN_TOKEN=demo-admin
APP_TZ=Europe/Moscow

# Feature flags (true/false)
FF_LLM=true
FF_ABSENCE_ACTIONS=true
FF_ACCESS_ACTIONS=true
FF_MENTOR_ESCALATION=true
FF_FAQ_FROM_ANSWERS=true
FF_PROACTIVE=true

# ИИ-крон: токен для POST /api/cron/reminders и встроенный таймер (0 — выключить)
CRON_TOKEN=demo-cron
REMINDER_INTERVAL_MINUTES=60
